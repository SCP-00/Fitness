{
  "_comment": "API format (POST /prompt). SD1.5 + OpenPose ControlNet — the tier that runs comfortably inside 6 GB (3-8 s per image at 768²). generate.mjs substitutes __POSE__, __SEED__, __POSITIVE__, __NEGATIVE__, __W__, __H__.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd15-base.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__POSITIVE__", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 768, "height": 768, "batch_size": 1 }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "__POSE__", "upload": "image" }
  },
  "6": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "control-openpose-sd15.safetensors" }
  },
  "7": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["6", 0],
      "image": ["5", 0],
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0,
      "vae": ["1", 2]
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["7", 0],
      "negative": ["7", 1],
      "latent_image": ["4", 0],
      "seed": "__SEED__",
      "steps": 26,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["8", 0], "vae": ["1", 2] }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "images": ["9", 0], "filename_prefix": "exercise" }
  }
}
