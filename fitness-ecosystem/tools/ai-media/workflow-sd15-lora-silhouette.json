{
  "_comment": "API format. Same as workflow-sd15-silhouette.json plus a style LoRA (node 2). Use with: node generate.mjs --lora my-style.safetensors [--trigger \"spStyle\"]  — generate.mjs replaces __LORA__ and prepends __TRIGGER__ to the prompt. One LoRA only: mixing two destroys the consistency that makes the set look like a set.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd15-base.safetensors" }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "__LORA__",
      "strength_model": 0.85,
      "strength_clip": 0.85,
      "model": ["1", 0],
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__POSITIVE__", "clip": ["2", 1] }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["2", 1] }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 768, "height": 768, "batch_size": 1 }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": { "image": "__POSE__", "upload": "image" }
  },
  "7": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "control-openpose-sd15.safetensors" }
  },
  "8": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["3", 0],
      "negative": ["4", 0],
      "control_net": ["7", 0],
      "image": ["6", 0],
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0,
      "vae": ["1", 2]
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["5", 0],
      "seed": "__SEED__",
      "steps": 26,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["1", 2] }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": { "images": ["10", 0], "filename_prefix": "exercise" }
  }
}
